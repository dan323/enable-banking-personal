<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.personal</groupId>
    <artifactId>enable-banking-personal</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>
    <name>enable-banking-personal</name>
    <description>Personal read-only dashboard over Enable Banking (PSD2)</description>

    <modules>
        <module>domain</module>
        <module>port</module>
        <module>application</module>
        <module>adapter-enablebanking</module>
        <module>adapter-persistence</module>
        <module>adapter-web</module>
        <module>bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>port</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>adapter-enablebanking</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.personal</groupId>
                <artifactId>adapter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- module-info.java is enforced at compile time; tests (JUnit/Mockito) run on the classpath -->
                    <useModulePath>false</useModulePath>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- Test libraries for every module -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
